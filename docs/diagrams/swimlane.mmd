flowchart TB
    subgraph guestLane ["Guest / Member"]
        start1((Start)) --> login[Login]
        login --> newUser{New user?}
        newUser -->|yes| reg[Register]
        reg --> login
        newUser -->|no| valid{Valid?}
        valid -->|no| login
        valid -->|yes| panel[Member Panel]
        panel --> active{Active?}
        active -->|no| pending[Pending Page]
        active -->|yes| browse[Browse Posts]
        browse --> createPost[Create Post]
        createPost --> sendMatch[Send Match]
        sendMatch --> accepted{Accepted?}
        accepted -->|yes| chat[Real-time Chat]
        accepted -->|no| sendMatch
        chat --> logout1[Logout]
        logout1 --> end1(((End)))
    end

    subgraph adminLane ["Administrator"]
        start2((Start)) --> adminLogin[Admin Login]
        adminLogin --> adminPanel[Admin Panel]
        adminPanel --> approve[Approve Account]
        adminPanel --> manageUsers[Manage Users]
        adminPanel --> reports[Review Reports]
        adminPanel --> analytics[View Analytics]
        approve --> logout2[Logout]
        manageUsers --> logout2
        reports --> logout2
        analytics --> logout2
        logout2 --> end2(((End)))
    end

    subgraph systemLane ["System"]
        auth[Authenticate]
        store[Store User Data]
        updateStatus[Update Status]
        processMatch[Process Match]
        socketChat[Socket.IO Chat]
    end

    reg -.->|registration data| store
    approve -.->|status = active| pending
    sendMatch -.->|match request| processMatch
